# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env fayli git'ga TUSHMAYDI — maxfiy qiymatlarni faqat shu yerda saqlang.

# --- Majburiy ---------------------------------------------------------------

# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=

# Sizning Telegram user ID'ingiz (@userinfobot ga yozing). Faqat shu odam
# chek tashlab to'lovni tasdiqlay oladi.
ADMIN_ID=

# --- Ixtiyoriy --------------------------------------------------------------

# So'rovlar keladigan guruh ID'si (manfiy raqam, masalan -1001234567890).
# Bo'sh qoldirsangiz bot qo'shilgan HAR QANDAY guruhni tinglaydi.
GROUP_CHAT_ID=

# Hisobotlar yuboriladigan chat. Bo'sh bo'lsa ADMIN_ID'ga shaxsiy xabar ketadi.
REPORT_CHAT_ID=

# console.anthropic.com'dan olingan kalit. Bo'sh bo'lsa:
#  - hisobotlar AI tahlilisiz, faqat raqamlar bilan yuboriladi
#  - chek rasmidan summa avtomatik o'qilmaydi (admin izohga qo'lda yozadi)
ANTHROPIC_API_KEY=

# Model. Sinovda haiku chek summasini 3/3 to'g'ri o'qidi va eng tez ishladi,
# shuning uchun standart shu. Taxminiy oylik xarajat (kuniga ~30 chek):
#   claude-haiku-4-5   — ~$2/oy   (standart)
#   claude-sonnet-5    — ~$7/oy
#   claude-opus-5      — ~$12/oy
# Chek noaniq o'qilayotgan bo'lsa qimmatroq modelga ko'tarish mumkin.
AI_MODEL=claude-haiku-4-5

# Vaqt zonasi va hisobot vaqtlari (HH:MM)
TZ=Asia/Tashkent
DAILY_REPORT_TIME=23:00
WEEKLY_REPORT_TIME=23:05
MONTHLY_CHECK_TIME=23:10

# Bot reaksiyalari. Telegram cheklangan ro'yxatdan tanlanadi —
# ✅ va ⏳ mavjud emas. Ishlaydiganlari: 👍 👀 🔥 👌 💯 🙏 🤝 ⚡
REACTION_RECEIVED=👀
REACTION_PAID=👌

# Telegram'ga tarmoq beqaror bo'lsa shularni oshiring
NETWORK_TIMEOUT=30
SEND_RETRIES=3

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
